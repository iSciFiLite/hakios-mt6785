# HakiOS MT6785 baseline. Keep the handset-specific drivers out until their handoff and register
# sequences have been ported and checked on hardware. The first bring-up profile uses one CPU.
CONFIG_SOC="mt6785"
CONFIG_CPUS=1
# CONFIG_CPUFREQ is not set
# CONFIG_GPU is not set
# CONFIG_UFS is not set
# CONFIG_UFS_ROOT is not set
# CONFIG_TOUCHSCREEN is not set
